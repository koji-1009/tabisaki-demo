---
import PrefectureCard from "../components/search/PrefectureCard";
import Layout from "../layouts/Layout.astro";
import { searchPrefectures } from "../services/prefectures.ts";
import pageStyles from "../styles/page.module.css";
import { REGION_IDS, type Region } from "../types/index.ts";

const url = new URL(Astro.request.url);
const query = url.searchParams.get("q") ?? "";
const regionParam = url.searchParams.get("region");
const region: Region | "all" =
	regionParam && REGION_IDS.includes(regionParam as Region)
		? (regionParam as Region)
		: "all";

const filtered = searchPrefectures({
	query: query || undefined,
	region: region !== "all" ? region : undefined,
});

const regions: { key: Region | "all"; label: string }[] = [
	{ key: "all", label: "すべて" },
	{ key: "hokkaido", label: "北海道" },
	{ key: "tohoku", label: "東北" },
	{ key: "kanto", label: "関東" },
	{ key: "chubu", label: "中部" },
	{ key: "kinki", label: "近畿" },
	{ key: "chugoku", label: "中国" },
	{ key: "shikoku", label: "四国" },
	{ key: "kyushu", label: "九州・沖縄" },
];

function chipHref(r: Region | "all"): string {
	const params = new URLSearchParams();
	if (query) params.set("q", query);
	if (r !== "all") params.set("region", r);
	const qs = params.toString();
	return qs ? `/search?${qs}` : "/search";
}
---

<Layout title="さがす">
	<main class={pageStyles.main}>
		<h1 class={pageStyles.pageTitle}>都道府県をさがす</h1>
		<form method="GET" action="/search">
			<label for="pref-search" class="sr-only">都道府県を検索</label>
			{region !== "all" && <input type="hidden" name="region" value={region} />}
			<input
				id="pref-search"
				name="q"
				type="text"
				placeholder="都道府県を検索..."
				value={query}
				class="search-input"
			/>
		</form>
		<div class="chips">
			{regions.map((r) => (
				<a
					href={chipHref(r.key)}
					class:list={["chip", { "chip-selected": region === r.key }]}
					data-astro-history="replace"
				>
					{r.label}
				</a>
			))}
		</div>
		<p class="count">{filtered.length}件</p>
		<div class="grid">
			{filtered.map((p) => (
				<PrefectureCard prefecture={p} />
			))}
		</div>
	</main>
</Layout>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.search-input {
		width: 100%;
		padding: 12px 16px;
		font-size: 16px;
		border-radius: 12px;
		border: 1px solid var(--md-sys-color-outline-variant, #cac4d0);
		background: var(--md-sys-color-surface-container-low, #f7f2fa);
		color: var(--md-sys-color-on-surface, #1c1b1f);
		outline: none;
		margin-bottom: 12px;
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 16px;
	}

	.chip {
		padding: 6px 14px;
		font-size: 13px;
		border-radius: 16px;
		cursor: pointer;
		font-weight: 500;
		text-decoration: none;
		background: var(--md-sys-color-surface-container-high, #ece6f0);
		color: var(--md-sys-color-on-surface-variant, #49454f);
	}

	.chip-selected {
		background: var(--md-sys-color-secondary-container, #e8def8);
		color: var(--md-sys-color-on-secondary-container, #1d192b);
	}

	.count {
		font-size: 13px;
		color: var(--md-sys-color-on-surface-variant, #49454f);
		margin-bottom: 12px;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 16px;
	}
</style>
